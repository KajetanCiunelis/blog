---
import Base from '../layouts/Base.astro';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const en = lang === 'en';
const site = 'https://tnr.ciunelis.com/';

const t = en
  ? {
      title: 'TNR',
      description:
        'Tools for Motor Learning Theory classes at AWF Warsaw: reaction time tests for the phone and a no-demonstration instruction game.',
      lead: 'Short phone-based tests for Motor Learning Theory classes (Teoria nauczania ruchu, AWF Warsaw). The tools are in Polish.',
      all: 'All tools',
      note: 'The tests run in the phone browser and install nothing. Results stay on the phone unless a student sends them to the group board under a pseudonym.',
    }
  : {
      title: 'TNR',
      description:
        'Narzędzia do ćwiczeń z Teorii nauczania ruchu, AWF Warszawa: testy czasu reakcji na telefonie i gra w instrukcję bez pokazu.',
      lead: 'Krótkie testy na telefon do ćwiczeń z Teorii nauczania ruchu (AWF Warszawa). Mierzysz zjawisko z zajęć na sobie, a wynik porównujesz z grupą.',
      all: 'Wszystkie narzędzia',
      note: 'Testy działają w przeglądarce telefonu i niczego nie instalują. Wyniki zostają na telefonie, chyba że student sam wyśle je na tablicę grupy pod pseudonimem.',
    };

const tools = en
  ? [
      {
        href: 'speedtest/',
        name: 'Reaction speedtest',
        desc: 'Nine tasks: simple and choice reaction time, countdown, rhythm, moving target, go/no-go, visual search, Stroop. Results can be sent to the group board.',
        meta: ['approx. 4 minutes', 'class 3'],
      },
      {
        href: 'czas-reakcji/',
        name: 'Reaction time: sight, sound, vibration',
        desc: 'A simple test in three modes (simple, 2-choice, 4-choice) with a choice of stimulus.',
        meta: ['vibration on Android only'],
      },
      {
        href: 'bez-pokazu/',
        name: 'Instruction without demonstration',
        desc: 'A game in pairs: put your partner into a position using words alone.',
        meta: ['approx. 10 minutes', 'class 8'],
      },
    ]
  : [
      {
        href: 'speedtest/',
        name: 'Speedtest reakcji',
        desc: '9 zadań: czas reakcji prosty i z wyborem, odliczanie, rytm, ruchomy cel, go/no-go, przeszukiwanie, Stroop. Wyniki można wysłać na tablicę grupy.',
        meta: ['ok. 4 minuty', 'zajęcia 3'],
      },
      {
        href: 'czas-reakcji/',
        name: 'Czas reakcji: wzrok, dźwięk, wibracja',
        desc: 'Prosty test w trzech trybach (prosty, wybór 2, wybór 4) z wyborem bodźca. Sprawdzisz, czy na dźwięk reagujesz szybciej niż na obraz.',
        meta: ['wibracja tylko na Androidzie'],
      },
      {
        href: 'bez-pokazu/',
        name: 'Instrukcja bez pokazu',
        desc: 'Gra w parach: ustaw partnera w pozycji samymi słowami.',
        meta: ['ok. 10 minut', 'zajęcia 8'],
      },
    ];
---

<Base
  title={t.title}
  description={t.description}
  lang={lang}
  path={en ? '/en/tnr/' : '/tnr/'}
  alternates={{ pl: '/tnr/', en: '/en/tnr/' }}
  switchHref={en ? '/tnr/' : '/en/tnr/'}
>
  <div class="no-justify" data-pagefind-body>
    <h1>{t.title}</h1>
    <p>{t.lead}</p>

    <div class="listing">
      {
        tools.map((tool) => (
          <a class="listing-item" href={site + tool.href}>
            <h2>{tool.name}</h2>
            <p class="listing-desc">{tool.desc}</p>
            <p class="listing-meta">
              {tool.meta.map((m) => (
                <span>{m}</span>
              ))}
            </p>
          </a>
        ))
      }
    </div>

    <p><a href={site}>{t.all}: tnr.ciunelis.com</a></p>
    <p class="listing-meta">{t.note}</p>
  </div>
</Base>

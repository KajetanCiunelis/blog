---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

interface Props {
  lang: 'pl' | 'en';
  /** Wersja do pracy: strona startowa (nazwisko, zdanie o mnie, portret, edukacja + publikacje). */
  home?: boolean;
}

const { lang, home = false } = Astro.props;
const en = lang === 'en';
const entry = await getEntry('pages', en ? 'publications-en' : 'publications-pl');
if (!entry) {
  throw new Error(`Brak treści strony "Publikacje" (${lang}) w src/content/pages/`);
}
const { Content } = await render(entry);

// Strona startowa wersji do pracy zastępuje "O mnie": edukacja (tylko AWF) trafia tutaj.
const about = home ? await getEntry('pages', en ? 'about-en' : 'about-pl') : undefined;
const education = (about?.data.education ?? []).filter((e) => e.meta.includes('AWF'));
const eduHeading = en ? 'Education' : 'Edukacja';
const intro = en
  ? 'Physiotherapist and PhD student at AWF Warsaw. I study trunk function and the biomechanics of wheelchair athletes within the Synergy project (GIH Stockholm).'
  : 'Fizjoterapeuta i doktorant AWF Warszawa. Badam funkcje tułowia i biomechanikę sportowców na wózkach w ramach projektu Synergy (GIH Stockholm).';

const pubPath = en ? '/en/publications/' : '/publications/';
const homePath = en ? '/en/' : '/';

const description = en
  ? 'Research publications, projects, conference presentations, and awards — Kajetan Ciunelis, AWF Warsaw.'
  : 'Publikacje naukowe, projekty badawcze, konferencje i nagrody — Kajetan Ciunelis, AWF Warszawa.';
---

<Base
  title={home ? 'Kajetan Ciunelis' : entry.data.title}
  description={home ? intro : description}
  lang={lang}
  path={home ? homePath : pubPath}
  alternates={home ? { pl: '/', en: '/en/' } : { pl: '/publications/', en: '/en/publications/' }}
  switchHref={home ? (en ? '/' : '/en/') : en ? '/publications/' : '/en/publications/'}
  fullTitle={home}
>
  <div class="no-justify" data-pagefind-body>
    {
      home ? (
        <>
          <h1>Kajetan Ciunelis</h1>
          <div class="pub-intro">
            <img
              class="pub-portrait"
              src="/images/portret.webp"
              alt={en ? 'Portrait of Kajetan Ciunelis' : 'Portret Kajetana Ciunelisa'}
              width="320"
              height="320"
            />
            <div>
              <p class="pub-lead">{intro}</p>
              <h2>{eduHeading}</h2>
              {education.map((e) => (
                <div class="edu-entry">
                  <strong>{e.degree}</strong>
                  <span class="edu-meta">{e.meta}</span>
                </div>
              ))}
            </div>
          </div>
        </>
      ) : (
        <h1>{entry.data.title}</h1>
      )
    }
    <Content />
  </div>
</Base>

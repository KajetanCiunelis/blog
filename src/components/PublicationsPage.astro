---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { WORK_MODE } from '../config';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const entry = await getEntry('pages', lang === 'en' ? 'publications-en' : 'publications-pl');
if (!entry) {
  throw new Error(`Brak treści strony "Publikacje" (${lang}) w src/content/pages/`);
}
const { Content } = await render(entry);
// Wersja do pracy nie ma strony "O mnie", więc edukacja (tylko AWF) trafia tutaj.
const about = WORK_MODE ? await getEntry('pages', lang === 'en' ? 'about-en' : 'about-pl') : undefined;
const education = (about?.data.education ?? []).filter((e) => e.meta.includes('AWF'));
const eduHeading = lang === 'en' ? 'Education' : 'Edukacja';

const path = lang === 'en' ? '/en/publications/' : '/publications/';

const description =
  lang === 'en'
    ? 'Research publications, projects, conference presentations, and awards — Kajetan Ciunelis, AWF Warsaw.'
    : 'Publikacje naukowe, projekty badawcze, konferencje i nagrody — Kajetan Ciunelis, AWF Warszawa.';
---

<Base
  title={entry.data.title}
  description={description}
  lang={lang}
  path={path}
  alternates={{ pl: '/publications/', en: '/en/publications/' }}
  switchHref={lang === 'en' ? '/publications/' : '/en/publications/'}
>
  <div class="no-justify" data-pagefind-body>
    <h1>{entry.data.title}</h1>
    {
      education.length > 0 && (
        <div class="pub-intro">
          <img
            class="pub-portrait"
            src="/images/portret-zielony.webp"
            alt={lang === 'en' ? 'Portrait of Kajetan Ciunelis' : 'Portret Kajetana Ciunelisa'}
            width="280"
            height="280"
          />
          <div>
            <h2>{eduHeading}</h2>
            {education.map((e) => (
              <div class="edu-entry">
                <strong>{e.degree}</strong>
                <span class="edu-meta">{e.meta}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }
    <Content />
  </div>
</Base>

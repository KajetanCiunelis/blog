---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const en = lang === 'en';
const entry = await getEntry('pages', en ? 'publications-en' : 'publications-pl');
if (!entry) {
  throw new Error(`Brak treści strony "Publikacje" (${lang}) w src/content/pages/`);
}
const { Content, headings } = await render(entry);
// Spis sekcji po prawej (jak TOC w postach), generowany z nagłówków H2 treści
const toc = (headings ?? []).filter((h) => h.depth === 2);
const tocTitle = en ? 'On this page' : 'Na tej stronie';
const path = en ? '/en/publications/' : '/publications/';

const description = en
  ? 'Research publications, projects, conference presentations, and awards — Kajetan Ciunelis, AWF Warsaw.'
  : 'Publikacje naukowe, projekty badawcze, konferencje i nagrody — Kajetan Ciunelis, AWF Warszawa.';
---

<Base
  title={entry.data.title}
  description={description}
  lang={lang}
  path={path}
  alternates={{ pl: '/publications/', en: '/en/publications/' }}
  switchHref={en ? '/publications/' : '/en/publications/'}
  wide
>
  <div class:list={['post', 'no-justify', { 'with-toc': toc.length > 1 }]} data-pagefind-body>
    <h1>{entry.data.title}</h1>
    <div class:list={['post-layout', { 'has-toc': toc.length > 1 }]}>
      <div class="pub-content">
        <Content />
      </div>
      {
        toc.length > 1 && (
          <aside class="toc" aria-label={tocTitle}>
            <div class="toc-inner">
              <p class="toc-title">{tocTitle}</p>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </div>
</Base>
